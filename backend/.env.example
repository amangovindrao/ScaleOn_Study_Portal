# ============================================================
# ScaleOn Internship Study Portal - Backend Environment
# Copy this file to `.env` and fill in real values.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Comma separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scaleon_portal?schema=public

# --- JWT / Auth ---
# Use long random strings (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Remember-me extends the refresh token lifetime
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

# --- Cookies ---
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- CSRF ---
CSRF_SECRET=change_me_csrf_secret

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/admin/google/callback

# --- Admin hidden route token (extra obscurity layer for /admin) ---
ADMIN_ROUTE_KEY=Y

# --- Security / Rate limiting ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Identity generators ---
INTERN_ID_PREFIX=SOINT
USERNAME_PREFIX=SO

# --- Email (architecture only; provider wired later) ---
EMAIL_PROVIDER=console
EMAIL_FROM=ScaleOn Portal <no-reply@scaleon.io>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Frontend URLs (for links inside emails) ---
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_URL=http://localhost:3000/reset-password
